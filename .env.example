# Database Connection (Vercel Postgres / Neon Serverless Postgres)
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/ghostprotocol?schema=public&sslmode=prefer"
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/ghostprotocol?sslmode=prefer"

# Ably Realtime Signaling Service (Get a free key at https://ably.com)
ABLY_API_KEY="your-ably-api-key-here"

# STUN / TURN Configuration (Public STUN + Optional Metered TURN credentials)
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"
NEXT_PUBLIC_TURN_SERVERS=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
