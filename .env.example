# ==============================================================================
# GhostProtocol - Zero-Knowledge P2P Multi-Device Realtime System
# ==============================================================================

# Database Connection (Vercel Postgres / Neon Serverless Postgres)
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/ghostprotocol?schema=public&sslmode=prefer"
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/ghostprotocol?sslmode=prefer"

# Ably Realtime Signaling Service (Get a free key at https://ably.com)
ABLY_API_KEY="your-ably-api-key-here"

# STUN / TURN Configuration
# STUN alone only finds host / server-reflexive candidates. Peers behind
# symmetric NAT or CGNAT (mobile data, corporate Wi-Fi, many home ISPs) never
# form a direct path, so audio, video, screen share AND the P2P DataChannel
# fail silently while chat/knock keep working over the signaling server.
#
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"

# --- TURN relay (recommended: ephemeral credentials) -------------------------
# Server-side only, NO NEXT_PUBLIC_ prefix: anything prefixed NEXT_PUBLIC_ is
# inlined into the browser bundle, so a relay password there is public and your
# bandwidth is free for the taking.
#
# /api/turn-credentials mints username=<expiry>:<client> and
# credential=base64(HMAC-SHA1(TURN_SECRET, username)); coturn recomputes the same
# HMAC via `use-auth-secret`. TURN_SECRET must match static-auth-secret in
# deploy/coturn/turnserver.conf byte for byte. Full walkthrough, including the
# exact Vercel setup: deploy/coturn/README.md
TURN_SECRET=""
TURN_URLS=""
# Optional, default 4h, clamped to 5 min - 24 h.
TURN_TTL_SECONDS=""

# Fixed credentials, for a managed relay with no REST API. Still server-side.
TURN_STATIC_USERNAME=""
TURN_STATIC_CREDENTIAL=""

# Legacy client-visible TURN config. Only for a relay this deployment does not
# front - it takes priority over everything above and is readable by any visitor.
# Leave empty to use the ephemeral flow, or the public fallback relay if unset.
NEXT_PUBLIC_TURN_SERVERS=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multiplatform Distribution & GitHub Releases (Optional)
# Format: "seu-usuario/seu-repositorio"
NEXT_PUBLIC_GITHUB_REPO="mur1ll0/papochan"

# Custom Direct Download Overrides (Optional - defaults to GitHub Releases latest)
# NEXT_PUBLIC_DOWNLOAD_WINDOWS="https://github.com/mur1ll0/papochan/releases/latest/download/papochan-setup.exe"
# NEXT_PUBLIC_DOWNLOAD_ANDROID="https://github.com/mur1ll0/papochan/releases/latest/download/papochan.apk"
# NEXT_PUBLIC_DOWNLOAD_MACOS="https://github.com/mur1ll0/papochan/releases/latest/download/papochan.dmg"
# NEXT_PUBLIC_DOWNLOAD_LINUX="https://github.com/mur1ll0/papochan/releases/latest/download/papochan.AppImage"

